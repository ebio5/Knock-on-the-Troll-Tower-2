--====================================================
-- トロールタワー2 - Anti-KB統合版 (Rayfield)
-- 🚨 新しい「Anti-KB」タブを追加し、指定されたImmunityコードをロード 🚨
--====================================================

-- Rayfield 公式読み込み
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- 変数定義
local player = game.Players.LocalPlayer
local noclipConnection = nil -- Noclipの接続を管理するための変数

-- ウィンドウ作成
local Window = Rayfield:CreateWindow({
    Name = "トロールタワー2 | Anti-KB統合版",
    LoadingTitle = "ロード中...",
    LoadingSubtitle = "Immunity Enabled",
    ConfigurationSaving = { Enabled = true, FolderName = nil, FileName = "TT2AntiKBConfig" },
})

--====================================================
-- タブ作成 (最終構成)
--====================================================
local AntiKBTab = Window:CreateTab("Anti-KB")      -- 新しい「Anti-KB」タブ
local UtilityTab = Window:CreateTab("ユーティリティ") -- ユーティリティ機能
local TeleportTab = Window:CreateTab("テレポート")
local VFlyTab = Window:CreateTab("VFly")

--====================================================
-- Anti-KBタブ (Knockback Immunity統合)
--====================================================

AntiKBTab:CreateButton({
    Name = "ノックバック耐性コードを実行",
    Callback = function()
        -- 外部スクリプトのロードと実行 (Immune slap tower work)
        loadstring(game:HttpGet("https://raw.githubusercontent.com/amdzy088/Immune-slap-tower-/refs/heads/main/Immune%20slap%20tower%20work"))()
        Rayfield:Notify({Title="Anti-KB", Content="ノックバック耐性コードをロードしました。", Duration=5})
    end
})

--====================================================
-- ユーティリティタブ (Noclip/Speed/SLAP Tool)
--====================================================

-- スピードスライダー
UtilityTab:CreateSlider({
    Name = "移動スピード",
    Range = {1, 300},
    Increment = 1,
    Suffix = "速度",
    CurrentValue = 16,
    Callback = function(val)
        if player.Character and player.Character:FindFirstChild("Humanoid") then
            player.Character.Humanoid.WalkSpeed = val
        end
    end
})

-- SLAP Toolを取得 (基本機能)
UtilityTab:CreateButton({
    Name = "SLAP Toolを取得 (基本機能)",
    Callback = function()
        local Tool = Instance.new("Tool")
        Tool.Name = "SLAPP Tool"
        Tool.RequiresHandle = false
        Tool.Parent = player.Backpack

        Tool.Activated:Connect(function()
            local mouse = player:GetMouse()
            local target = mouse.Target
            if target and target:IsA("BasePart") then
                local touch = target:FindFirstChildOfClass("TouchTransmitter")
                if touch and player.Character and player.Character.PrimaryPart then
                    firetouchinterest(player.Character.PrimaryPart, target, 0)
                    firetouchinterest(player.Character.PrimaryPart, target, 1)
                end
            end
        end)
        Rayfield:Notify({Title="SLAP Tool", Content="基本SLAP Toolがバックパックに作成されました。", Duration=2})
    end
})

-- Noclip (壁すり抜け)
UtilityTab:CreateToggle({
    Name = "Noclip (壁すり抜け)",
    CurrentValue = false,
    Callback = function(value)
        if value then
            if not noclipConnection then
                noclipConnection = game:GetService("RunService").Stepped:Connect(function()
                    if player.Character then
                        for _, part in pairs(player.Character:GetDescendants()) do
                            if part:IsA("BasePart") and part.CanCollide then
                                part.CanCollide = false
                            end
                        end
                    end
                end)
            end
        else
            if noclipConnection then
                noclipConnection:Disconnect()
                noclipConnection = nil
            end
        end
    end
})

--====================================================
-- テレポートタブ
--====================================================
local Teleports = {
    ["ゴールにテレポート"] = CFrame.new(280.42, 347.15, -35.34),
    ["トロール地点にテレポート"] = CFrame.new(-78.19, 148.41, -81.99),
    ["リスポーン地点にテレポート"] = CFrame.new(-5.17, 3.15, -4.78),
    ["グループのスキップにテレポート"] = CFrame.new(-32.50, -1.61, -78.11)
}

for name, cf in pairs(Teleports) do
    TeleportTab:CreateButton({
        Name = name,
        Callback = function()
            if player.Character and player.Character.PrimaryPart then
                player.Character:SetPrimaryPartCFrame(cf)
            end
        end
    })
end

--====================================================
-- VFlyタブ
--====================================================
VFlyTab:CreateButton({
    Name = "VFly GUIを実行",
    Callback = function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/makkurokurosukescript/VFly-gui/refs/heads/main/VFly%20gui", true))()
        Rayfield:Notify({Title="VFly", Content="VFly GUIがロードされました。", Duration=3})
    end
})
