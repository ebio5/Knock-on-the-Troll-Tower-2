sub.TextXAlignment = Enum.TextXAlignment.Left
sub.ZIndex = 51
sub.Parent = card

-- ロード進行（2秒ごとに1/4）
task.spawn(function()
    for i = 1,4 do
        TweenService:Create(
            bar,
            TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {Size = UDim2.fromOffset(95 * i,22)}
        ):Play()
        task.wait(2)
    end

    -- 下に10ずつ落としながら消す
    for step = 1,12 do
        card.Position = card.Position + UDim2.new(0,0,0,10)
        card.BackgroundTransparency += 0.05
        task.wait(0.03)
    end

    gui:Destroy()

    -- ✅ ロード完了後にスクリプト実行
    loadstring(game:HttpGet(
        "https://raw.githubusercontent.com/ebio5/Knock-on-the-Troll-Tower-2/refs/heads/main/KEY-LESS-Script-DELTA"
    ))()
end)
